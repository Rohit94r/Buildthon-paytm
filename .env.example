# LayerFlow — copy to .env and fill in (scripts/vps/install.sh does this for you). Never commit .env.
# Full guide: docs/setup/vps-hostinger-kvm8.md · models: docs/setup/models.md

# ---- Core ----
APP_ENV=production
# 32+ random characters:  openssl rand -base64 48
APP_SECRET_KEY=
# Public URL of the dashboard + API (Caddy serves both on one domain)
APP_BASE_URL=https://agents.example.com
DOMAIN=agents.example.com
# Home workspace of the first admin (the original newsroom tenant)
TENANT_DEFAULT=ten
LOG_LEVEL=info

# First platform admin (applied by bootstrap only when no users exist yet). Password: 10+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Let companies create their own workspace at /register (free plan). false = only you create clients.
ALLOW_SIGNUP=false

# ---- Database ----
POSTGRES_USER=layerflow
POSTGRES_PASSWORD=
POSTGRES_DB=layerflow
# docker-compose builds DATABASE_URL from the three values above. For local dev without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./data/dev.db

# ---- Models (local, no paid API keys) ----
# ollama | openai_compat | mock   (mock = deterministic output for UI work; labelled in the UI)
MODEL_PROVIDER=ollama
# local-model runs Ollama inside compose. For a model on another machine (GPU box over Tailscale),
# remove local-model and set e.g. OLLAMA_BASE_URL=http://100.x.y.z:11434
COMPOSE_PROFILES=local-model
OLLAMA_BASE_URL=http://ollama:11434
# KVM 8 (8 vCPU / 32 GB, CPU only) defaults — see docs/setup/models.md
#   writer: rewriting, articles, multi-format content     (≈4.7 GB, ~8–12 tok/s on 8 vCPU)
#   fast:   real-time comparison chat, routing, short posts (≈2 GB,  ~18–25 tok/s)
MODEL_WRITER=qwen2.5:7b-instruct
MODEL_FAST=qwen2.5:3b-instruct
MODEL_EMBED=nomic-embed-text
# Optional vision model: image alt text / captions for the image agents (~1.7 GB). Empty = text-only fallback.
MODEL_VISION=
# MODEL_VISION=moondream
# Higher quality, ~2x slower writer (≈9 GB) — good for overnight/batch pipelines:
# MODEL_WRITER=qwen2.5:14b-instruct
MODEL_TIMEOUT_S=600
# Parallel model jobs in the worker. 1 is right for CPU; the assistant chat bypasses the queue.
MODEL_CONCURRENCY=1
MODEL_NUM_CTX=8192
# Ollama tuning (docker-compose.yml): models kept warm, parallel requests, memory cap
OLLAMA_MAX_LOADED_MODELS=4
OLLAMA_NUM_PARALLEL=2
OLLAMA_KEEP_ALIVE=24h
OLLAMA_MEM_LIMIT=20g
# Optional OpenAI-compatible endpoint (free tier / self-hosted GPU / paid) — MODEL_PROVIDER=openai_compat
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# ---- Fetching / scraping ----
FETCH_USER_AGENT="LayerFlowBot/1.0 (+https://agents.example.com/bot; contact@example.com)"
FETCH_MAX_PER_DOMAIN=1
FETCH_CACHE_DAYS=7

# ---- Security of stored secrets ----
# Fernet key that encrypts connection secrets (WordPress passwords, bot tokens, webhook secrets) at rest.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Newsroom module (legacy single-site publishing for the TEN workspace) ----
PUBLISH_TARGET=export
TEN_SITE_URL=https://theexecutivenarrative.com
TEN_SFTP_HOST=
TEN_SFTP_PORT=22
TEN_SFTP_USER=
TEN_SFTP_KEY_PATH=
TEN_PUBLIC_ROOT=/public_html
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
WEBHOOK_URL=
WEBHOOK_SECRET=

# ---- LinkedIn (optional; official API only) ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# defaults to $APP_BASE_URL/api/v1/settings/integrations/linkedin/callback
LINKEDIN_REDIRECT_URI=
LINKEDIN_ORG_URN=
LINKEDIN_API_VERSION=202606

# ---- Ops ----
BACKUP_KEEP=14
BACKUP_RCLONE_REMOTE=
ALERT_WEBHOOK_URL=
DISK_ALERT_PCT=85
RATE_LIMIT_MUTATIONS_PER_MIN=120
RATE_LIMIT_READS_PER_MIN=1200
# Public API (client websites / widget / SDK), per API key + IP
PUBLIC_API_RATE_PER_MIN=120
PUBLIC_CHAT_RATE_PER_MIN=20
# Allow REST API / webhook connections to private network addresses (only for an internal CRM on the same LAN/VPN)
CONNECTIONS_ALLOW_PRIVATE=false
